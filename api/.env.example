# API settings. The real file is api/.env (never committed). Names only here, no values.
# For local development run, from the repository root:
#   powershell -ExecutionPolicy Bypass -File scripts/new-local-env.ps1

# local, test or production (default: local)
APP_ENV=
# DEBUG, INFO, WARNING or ERROR (default: INFO)
LOG_LEVEL=

# Required. Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# The user the running API connects as. It must be a limited user, not the database owner.
DATABASE_URL=
# Required for migrations and the account commands. Same format, the database owner.
MIGRATION_DATABASE_URL=
# Required. A long random value (32 characters or more) that signs sign-in tokens.
# For local development, fill the three settings above with:
#   uv run python -m app.cli setup-local
JWT_SECRET=
# Optional. Sign-in attempts allowed per minute from one address (default: 5).
LOGIN_RATE_PER_MINUTE=
# Optional. Number of our own forwarding servers in front of the API (default: 0).
TRUSTED_PROXY_COUNT=
# Required. Format: redis://HOST:PORT/NUMBER
REDIS_URL=

# AI (Groq). Create the key at console.groq.com > API Keys, and type it here yourself.
GROQ_API_KEY=
# The date (YYYY-MM-DD) you turned on Zero Data Retention at
# console.groq.com > Settings > Data Controls. No personal data is sent to AI without it.
GROQ_ZDR_CONFIRMED_ON=
# Optional. Which models to use (defaults in app/config.py).
AI_MAIN_MODEL=
AI_SMALL_MODEL=
AI_JUDGE_MODEL=
# Optional. Groq's limits for your account (defaults: 30, 1000, 8000, 200000).
AI_REQUESTS_PER_MINUTE=
AI_REQUESTS_PER_DAY=
AI_TOKENS_PER_MINUTE=
AI_TOKENS_PER_DAY=
# Optional. Folder for uploaded files (default: api/var/uploads).
STORAGE_DIR=

# Needed only to run the automated tests. Use the database owner. The test database name
# must end in _test, because the tests delete its contents.
TEST_DATABASE_URL=
TEST_REDIS_URL=
