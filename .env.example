# Settings for the local containers (docker-compose.yml). Local development only: never real secrets.
# Create the real file by running, in PowerShell from this folder:
#   powershell -ExecutionPolicy Bypass -File scripts/new-local-env.ps1
# or copy this file to .env and fill in the values yourself.

# Database user, password and database name created inside the Postgres container.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Ports on your machine (127.0.0.1 only). Leave empty for the defaults 5432 and 6379.
# If a port is already in use, set another number here AND in api/.env.
POSTGRES_PORT=
REDIS_PORT=
